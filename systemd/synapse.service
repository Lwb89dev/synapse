[Unit]
Description=Synapse bridge (phone remote control for terminal AI agents)
After=network-online.target

[Service]
ExecStart=%h/.local/bin/synapse serve
Restart=on-failure
# The agents' tmux sessions live in this unit's cgroup: restarting (or upgrading) the bridge must not kill them.
KillMode=process
RestartSec=3
# tmux/agents are found through the interactive shell, but the server itself only needs these
# agents are started through the login shell so mise/nvm PATH tweaks apply (%s = the user's shell)
Environment=SHELL=%s
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin

[Install]
WantedBy=default.target
